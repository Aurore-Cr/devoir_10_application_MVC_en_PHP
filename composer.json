{
    "name": "cenef/touche-pas-au-klaxon",
    "description": "Application de covoiturage inter-sites - devoir MVC PHP (CENEF)",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "phpstan/phpstan": "^1.11"
    },
    "autoload": {
